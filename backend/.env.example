# =====================================================================
# Sales Pipeline Autopilot - Backend Environment Configuration (.env)
# =====================================================================

# [Optional] Supabase Database & Auth Configuration
# If omitted or left as placeholder, system uses persistent local_db.json fallback
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# [Optional] SerpAPI Key for Google Maps Lead Discovery
# Get a free API key at https://serpapi.com/
SERPAPI_API_KEY=your-serpapi-key

# [Required for Public Chat Links] Public Frontend Domain
# Used to generate customer-facing private chat links (e.g. https://your-domain.com or http://localhost:5173)
PUBLIC_FRONTEND_URL=http://localhost:5173

# [AI Email Drafting] Google Gemini API Key
# If omitted, system seamlessly falls back to the deterministic local grounded template engine
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# [Gmail Draft Integration] Google Cloud OAuth 2.0 Credentials
# Required to create drafts directly in your Gmail Drafts folder (NEVER sends automatically)
# Setup in Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID (Web Application)
# Authorized redirect URI: http://localhost:5000/api/gmail/oauth/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/oauth/callback

# [Server Configuration]
PORT=5000
FLASK_ENV=development
